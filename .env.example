# DisasterIntel Global Environment Configuration

# Backend Settings
APP_NAME=DisasterIntel
APP_ENV=development
API_VERSION=v1
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Local development uses SQLite:
DATABASE_URL=sqlite:///./disasterintel.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://disasterintel:secret@localhost:5432/disasterintel

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# External Meteorological APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
NCMRWF_API_URL=https://ncmrwf.gov.in/api

# Ingestion & Model Parameters
DATA_MODE=live
FALLBACK_TO_DEMO_ON_FAIL=true
MODEL_ARTIFACTS_DIR=../../ml/artifacts

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=DisasterIntel
